# Kies één AI-provider. Zonder sleutel draait The Captain op de ingebouwde offline coaching-engine.

# Optie 1 (aanbevolen): OpenAI
OPENAI_API_KEY=
# Standaardmodel bij OpenAI: gpt-4.1
CAPTAIN_MODEL=gpt-4.1

# Optie 2: Claude (alleen gebruikt als er geen OPENAI_API_KEY staat)
ANTHROPIC_API_KEY=
# Standaardmodel bij Claude: claude-opus-5

PORT=3000
